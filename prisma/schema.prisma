// Modelo de datos compartido de la PGPC · BORRADOR v1 para revisión del equipo.
// Referencias: PGPC-SDD-V4-2026 y docs/PLAN_DE_TRABAJO.md.
// Cualquier cambio entra por PR con migración (`npx prisma migrate dev --name ...`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Seguridad (RNF-005) · Integrante 1 ─────────────────────────────────────

enum Rol {
  ADMINISTRADOR
  COORDINADOR
  DOCENTE
}

// Un perfil por usuario de Supabase Auth; `id` es el uuid de auth.users.
model Perfil {
  id         String         @id @db.Uuid
  correo     String         @unique
  rol        Rol            @default(DOCENTE)
  profesorId Int?           @unique
  profesor   Profesor?      @relation(fields: [profesorId], references: [id])
  // Panel de administración (#241): un perfil desactivado conserva sus registros pero no entra.
  activo     Boolean        @default(true)
  // Tema de la interfaz que eligió la persona («claro» u «oscuro»; #283). Vacío = nunca eligió.
  // Lo valida src/modules/cuenta/tema.ts antes de guardar.
  tema       String?
  creadoEn   DateTime       @default(now())
  accesos    AccesoModulo[]
}

// Visitas de cada persona a cada módulo, para «Accesos frecuentes» de Mi cuenta (issue #226).
// Solo el slug del módulo y un conteo: no guarda rutas, parámetros ni identificadores de registros.
model AccesoModulo {
  id           Int      @id @default(autoincrement())
  perfilId     String   @db.Uuid
  perfil       Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  modulo       String
  conteo       Int      @default(1)
  ultimoAcceso DateTime @default(now())

  @@unique([perfilId, modulo])
}

// Bitácora de auditoría del panel de administración (issue 242): quién hizo qué y cuándo.
// Es un registro histórico: no se edita ni se elimina. Sin relación con Perfil a propósito, para que
// desactivar o cambiar un perfil no altere lo ya registrado; el correo se copia al momento del hecho.
// `resumen` es un texto legible en español. Lleva el correo de la persona afectada (igual que `actorCorreo`)
// y, de un profesor, solo su código; nunca teléfonos, nombres de profesores ni secretos.
model Auditoria {
  id          Int      @id @default(autoincrement())
  creadoEn    DateTime @default(now())
  actorId     String?  @db.Uuid
  actorCorreo String
  modulo      String
  accion      String
  entidad     String
  entidadId   String
  resumen     String

  @@index([creadoEn])
  @@index([modulo, accion])
}

// ─── M1 Catálogos (RF-001 a RF-003) · Integrante 1 ──────────────────────────

model GradoCientifico {
  id           Int        @id @default(autoincrement())
  nombre       String     @unique
  nomenclatura String     @unique
  profesores   Profesor[]
}

model Division {
  id            Int            @id @default(autoincrement())
  nombre        String
  clave         String         @unique
  departamentos Departamento[]
}

model Departamento {
  id                Int                 @id @default(autoincrement())
  nombre            String
  nomenclatura      String              @unique
  divisionId        Int
  division          Division            @relation(fields: [divisionId], references: [id])
  profesores        Profesor[]
  cuerposAcademicos CuerpoAcademico[]
  programas         ProgramaEducativo[]
}

// No está en el SDD; lo requiere RF-029 (plan §8, punto 2).
model ProgramaEducativo {
  id             Int           @id @default(autoincrement())
  nombre         String
  clave          String        @unique
  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  profesores     Profesor[]
}

// ─── M2 Profesores (RF-004 a RF-006) · Integrante 2 ─────────────────────────

enum Genero {
  M
  F
}

enum TipoContratacion {
  TIEMPO_COMPLETO
  ASIGNATURA
}

enum EstatusLaboral {
  ACTIVO
  LICENCIA
  BAJA_TEMPORAL
  BAJA_POSDOCTORAL
  TRASLADADO
}

model Profesor {
  id                    Int                         @id @default(autoincrement())
  codigo                String                      @unique // Código CUValles
  nombres               String
  apellidos             String
  // Nombre sin acentos, en minúsculas; lo usa el cruce de listados oficiales (RF-018).
  nombreNormalizado     String
  correo                String                      @unique
  genero                Genero
  tipoContratacion      TipoContratacion
  estatusLaboral        EstatusLaboral              @default(ACTIVO)
  gradoId               Int?
  grado                 GradoCientifico?            @relation(fields: [gradoId], references: [id])
  departamentoId        Int?
  departamento          Departamento?               @relation(fields: [departamentoId], references: [id])
  cvu                   String?                     @unique
  orcid                 String?                     @unique
  scopusId              String?                     @unique
  scholarId             String?                     @unique
  programas             ProgramaEducativo[]
  perfil                Perfil?
  reconocimientosSnii   ReconocimientoSnii[]
  reconocimientosProdep ReconocimientoProdep[]
  cuerposAcademicos     IntegranteCa[]
  cuerposLiderados      CuerpoAcademico[]           @relation("LiderCa")
  lgacs                 Lgac[]
  participaciones       ParticipacionConvocatoria[]
  renglonesResultado    RenglonResultado[] // RF-018: renglones de listados oficiales que coincidieron
  autorias              Autoria[]
  cortesEscaneo         CorteEscaneo[]
  creadoEn              DateTime                    @default(now())
  actualizadoEn         DateTime                    @updatedAt

  @@index([nombreNormalizado])
}

// ─── M3 Reconocimientos SNII / PRODEP (RF-007 a RF-011) · Integrante 3 ──────

enum NivelSnii {
  CANDIDATO
  NIVEL_1
  NIVEL_2
  NIVEL_3
  EMERITO
  NO_APROBADO
}

enum TipoParticipacionSnii {
  NUEVO_INGRESO
  RENOVACION
  REINGRESO_NO_VIGENTE
}

enum TipoSolicitudProdep {
  PRIMER_RECONOCIMIENTO
  RENOVACION
}

enum ResultadoDictamen {
  APROBADO
  NO_APROBADO
  EN_RECONSIDERACION
}

model ReconocimientoSnii {
  id                Int                   @id @default(autoincrement())
  profesorId        Int
  profesor          Profesor              @relation(fields: [profesorId], references: [id])
  nivel             NivelSnii
  tipoParticipacion TipoParticipacionSnii
  resultado         ResultadoDictamen
  inicio            DateTime              @db.Date
  fin               DateTime              @db.Date
  convocatoriaId    Int?
  convocatoria      Convocatoria?         @relation(fields: [convocatoriaId], references: [id])
  creadoEn          DateTime              @default(now())

  @@index([fin])
}

// El solapamiento de periodos (RF-011) se valida en src/modules/reconocimientos.
model ReconocimientoProdep {
  id             Int                 @id @default(autoincrement())
  profesorId     Int
  profesor       Profesor            @relation(fields: [profesorId], references: [id])
  tipoSolicitud  TipoSolicitudProdep
  resultado      ResultadoDictamen
  inicio         DateTime            @db.Date
  fin            DateTime            @db.Date
  convocatoriaId Int?
  convocatoria   Convocatoria?       @relation(fields: [convocatoriaId], references: [id])
  creadoEn       DateTime            @default(now())

  @@index([fin])
}

// ─── M4 Cuerpos Académicos (RF-012 a RF-015) · Integrante 4 ─────────────────

enum NivelConsolidacion {
  EN_FORMACION
  EN_CONSOLIDACION
  CONSOLIDADO
}

model CuerpoAcademico {
  id              Int                @id @default(autoincrement())
  clave           String             @unique
  nombre          String
  nivel           NivelConsolidacion
  areaProdep      String
  disciplina      String
  departamentoId  Int
  departamento    Departamento       @relation(fields: [departamentoId], references: [id])
  anioRegistro    Int
  anioVencimiento Int
  // Líder único por construcción (RF-014). Debe ser integrante del CA; lo valida
  // src/modules/cuerpos-academicos antes de guardar.
  liderId         Int?
  lider           Profesor?          @relation("LiderCa", fields: [liderId], references: [id])
  integrantes     IntegranteCa[]
  lgacs           Lgac[]
}

model IntegranteCa {
  cuerpoId   Int
  cuerpo     CuerpoAcademico @relation(fields: [cuerpoId], references: [id], onDelete: Cascade)
  profesorId Int
  profesor   Profesor        @relation(fields: [profesorId], references: [id])

  @@id([cuerpoId, profesorId])
}

model Lgac {
  id          Int             @id @default(autoincrement())
  cuerpoId    Int
  cuerpo      CuerpoAcademico @relation(fields: [cuerpoId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  profesores  Profesor[]
}

// ─── M5 Ingesta de convocatorias (RF-016 a RF-019) · Integrante 5 ───────────

enum ProgramaConvocatoria {
  SNII
  PRODEP
}

enum OrigenParticipacion {
  MANUAL
  LISTADO
}

enum CriterioCruce {
  CVU
  CODIGO
  NOMBRE
  AMBIGUO
  SIN_COINCIDENCIA
}

enum EstadoCarga {
  PROCESANDO
  EN_REVISION
  CONFIRMADA
  FALLIDA
}

model Convocatoria {
  id                    Int                         @id @default(autoincrement())
  programa              ProgramaConvocatoria
  anio                  Int
  participaciones       ParticipacionConvocatoria[]
  cargas                CargaResultados[]
  reconocimientosSnii   ReconocimientoSnii[]
  reconocimientosProdep ReconocimientoProdep[]

  @@unique([programa, anio])
}

// Quién participó en la convocatoria (RF-018; plan §8, punto 1).
model ParticipacionConvocatoria {
  id             Int                 @id @default(autoincrement())
  convocatoriaId Int
  convocatoria   Convocatoria        @relation(fields: [convocatoriaId], references: [id])
  profesorId     Int
  profesor       Profesor            @relation(fields: [profesorId], references: [id])
  resultado      ResultadoDictamen?
  // RF-018: MANUAL = registrado en la pantalla de participantes; LISTADO = agregado por el cruce.
  origen         OrigenParticipacion @default(MANUAL)

  @@unique([convocatoriaId, profesorId])
}

// Archivo oficial cargado y el balance que se muestra antes de confirmar (RF-019).
model CargaResultados {
  id             Int                @id @default(autoincrement())
  convocatoriaId Int
  convocatoria   Convocatoria       @relation(fields: [convocatoriaId], references: [id])
  archivoRuta    String // ruta en Supabase Storage
  estado         EstadoCarga        @default(PROCESANDO)
  balance        Json?
  cargadaPor     String             @db.Uuid
  creadaEn       DateTime           @default(now())
  renglones      RenglonResultado[]
}

// RF-017: lo que trae el listado oficial, un renglón por persona. Nada se calcula: el SNII no
// publica Código ni Vigencia y quedan vacíos (D-224). RF-018 lo cruza con el directorio.
model RenglonResultado {
  id              Int             @id @default(autoincrement())
  cargaId         Int
  carga           CargaResultados @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  numero          Int // renglón dentro del archivo
  cvu             String?
  codigo          String? // Código CUValles, si el archivo lo trae
  apellidoPaterno String? // vacío si el archivo trae el nombre en una sola columna
  apellidoMaterno String?
  nombres         String
  nivelTexto      String? // tal como viene en el archivo
  nivel           NivelSnii? // traducido; solo SNII
  vigenciaInicio  DateTime?       @db.Date // solo si el archivo la trae
  vigenciaFin     DateTime?       @db.Date
  // RF-018: profesor activo con que coincidió y por qué criterio (nulo = aún sin cruzar).
  profesorId      Int?
  profesor        Profesor?       @relation(fields: [profesorId], references: [id], onDelete: SetNull)
  criterio        CriterioCruce?

  @@unique([cargaId, numero])
  @@index([cargaId, cvu])
  @@index([profesorId])
}

// ─── M6 Producción científica (RF-020 a RF-025) · Integrantes 6 y 7 ─────────

enum TipoPublicacion {
  ARTICULO
  LIBRO
  CAPITULO
  MEMORIA_CONGRESO
  REGISTRO_SOFTWARE
  PATENTE
  OTRO
}

enum FuentePublicacion {
  ORCID
  SCOPUS
  OPENALEX
  GOOGLE_SCHOLAR
  CROSSREF
  MANUAL
}

enum EstadoAutoria {
  PENDIENTE
  VALIDADA
  RECHAZADA // queda como registro de exclusiones (CU-013)
}

// RNF-004: DOI único en BD. La similitud de títulos se revisa en la aplicación con
// similarity() de pg_trgm sobre este índice GIN (plan §8, punto 7). La extensión
// pg_trgm se crea en la migración inicial.
model Publicacion {
  id                Int               @id @default(autoincrement())
  tipo              TipoPublicacion
  titulo            String
  tituloNormalizado String
  doi               String?           @unique
  autoresTexto      String
  revistaEditorial  String?
  isbnIssn          String?
  fechaPublicacion  DateTime?         @db.Date
  volumen           String?
  paginas           String?
  evidenciaUrl      String?
  fuente            FuentePublicacion
  autorias          Autoria[]
  creadaEn          DateTime          @default(now())

  @@index([tituloNormalizado(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Vínculo publicación–profesor; permite coautorías sin duplicar la obra (RF-022).
model Autoria {
  publicacionId Int
  publicacion   Publicacion   @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  profesorId    Int
  profesor      Profesor      @relation(fields: [profesorId], references: [id])
  estado        EstadoAutoria @default(PENDIENTE)
  revisadaEn    DateTime?

  @@id([publicacionId, profesorId])
  @@index([profesorId, estado])
}

// Última fecha de corte por profesor y fuente para el escaneo incremental (RF-020).
model CorteEscaneo {
  profesorId  Int
  profesor    Profesor          @relation(fields: [profesorId], references: [id])
  fuente      FuentePublicacion
  ultimaFecha DateTime

  @@id([profesorId, fuente])
}

// ─── Trabajos en segundo plano (RNF-001) · Integrante 5 ─────────────────────

enum EstadoJob {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  FALLIDO
}

// Secreto institucional cifrado; sin acceso desde la Data API de Supabase.
model ConfiguracionScopus {
  id            String   @id
  claveCifrada  String
  actualizadaEn DateTime @updatedAt
}

model Job {
  id            Int       @id @default(autoincrement())
  tipo          String // p. ej. "escaneo", "carga-resultados"
  estado        EstadoJob @default(PENDIENTE)
  avance        Int       @default(0)
  total         Int       @default(0)
  datos         Json?
  error         String?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([estado, tipo])
}
