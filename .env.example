# Copia este archivo como .env con las llaves del proyecto de Supabase de DESARROLLO.
# Lo leen Next.js, la CLI de Prisma y los scripts. Nunca lo subas al repositorio.

# Supabase › Connect › Transaction pooler (puerto 6543): la usa la aplicación.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase › Connect › Session pooler (puerto 5432): la usan las migraciones y los scripts.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase › Project Settings › Data API y › API Keys
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secreto que Vercel Cron envía a /api/cron/* (cualquier cadena larga y aleatoria).
CRON_SECRET=""

# Solo para `npm run crear-admin`, en tu máquina. NO cargarla en Vercel.
SUPABASE_SECRET_KEY=""
ADMIN_CORREO=""
